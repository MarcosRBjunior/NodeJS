{
  "name": "bordeless",
  "version": "1.0.0",
  "description": "API REST de livraria (Autores/Editoras/Livros/Vendas) sobre PostgreSQL + Knex",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#src/*.js": "./src/*.js",
    "#config/*.js": "./src/config/*.js",
    "#controllers/*.js": "./src/controllers/*.js",
    "#db/*.js": "./src/db/*.js",
    "#domain/*.js": "./src/domain/*.js",
    "#services/*.js": "./src/services/*.js",
    "#gateways/*.js": "./src/gateways/*.js",
    "#erros/*.js": "./src/erros/*.js",
    "#middlewares/*.js": "./src/middlewares/*.js",
    "#utils/*.js": "./src/utils/*.js",
    "#models/*.js": "./src/models/*.js",
    "#routes/*.js": "./src/routes/*.js",
    "#test/*.js": "./test/*.js"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --env-file=.env.test --test 'test/unit/**/*.unit-spec.js'",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 'test/integration/**/*.integration-spec.js'",
    "test:e2e": "node --env-file=.env.test --test --test-concurrency=1 'test/e2e/**/*.e2e-spec.js'",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0"
  }
}
